# Copy this file to `.env` and fill in your key, then save:
#   cp .env.example .env
# The web server loads `.env` from the repo root automatically.
# An explicit `export GEMINI_API_KEY=…` in your shell still takes precedence.
GEMINI_API_KEY=your-gemini-api-key

# --- Local models (copied into ./models by scripts/copy_models.sh) ---------------------
# ASR: a local faster-whisper model dir (loaded offline). Point at the copied large-v3.
TRANSCRIBE_MODEL=./models/faster-whisper-large-v3

# HuggingFace cache holding the pyannote diarization weights + any HF alignment models.
HF_HOME=./models/hf-cache

# Torch hub cache holding the torchaudio English wav2vec2 alignment model.
TORCH_HOME=./models/torch-cache

# --- Speaker diarization (optional) ----------------------------------------------------
# Diarization is auto-enabled when HF_TOKEN is present. It needs the gated pyannote weights:
# create a token at https://huggingface.co/settings/tokens, then accept the model terms at
# https://huggingface.co/pyannote/speaker-diarization-community-1. Without a token, words
# carry no speaker label (everyone becomes "Person A").
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional Gemini model overrides (defaults track the newest free-tier -latest aliases) ---
# GEMINI_JUDGE_MODEL=gemini-flash-latest
# GEMINI_CLASSIFY_MODEL=gemini-flash-lite-latest

# --- Clip export -----------------------------------------------------------------------
# Exports render to DaVinci Resolve-friendly DNxHR .mov (the free Linux build can't decode
# H.264/H.265). By default they land in ~/Downloads. Override the folder and/or the DNxHR
# profile (dnxhr_lb | dnxhr_sq | dnxhr_hq | dnxhr_hqx | dnxhr_444; default dnxhr_sq).
# CLIPGEN_EXPORT_DIR=~/Downloads
# CLIPGEN_DNXHR_PROFILE=dnxhr_sq
